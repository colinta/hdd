{
  "name": "hdd-viz",
  "version": "1.2.6",
  "type": "module",
  "main": ".dist/index.js",
  "license": "",
  "bin": {
    "hdd": ".dist/index.js"
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node scripts/build.cjs",
    "start": "pnpm run build && node --enable-source-maps -- .dist/index.js",
    "clean": "rm -rf .dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "bench": "pnpm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@teaui/core": "1.20.24",
    "@teaui/react": "1.20.24",
    "@types/node": "^24.13.2",
    "commander": "^15.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
